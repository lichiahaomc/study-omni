# ============================================
# 本地密钥 —— 复制本文件为 .dev.vars 后填写
# .dev.vars 已在 .gitignore 中,不会被提交到仓库
# ============================================

# 默认走哪一家:deepseek / gemini / openai
# 推荐 deepseek —— 输出 ¥4.5~9 每百万 tokens,比 OpenAI / Gemini 旗舰档便宜 10~24 倍
LLM_PROVIDER=deepseek

# DeepSeek —— 首选
# 控制台 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Google Gemini —— 视觉识别兜底/对比用
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI —— 兜底
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============================================
# 以下都是可选项,不填就用代码里的默认值
# ============================================

# 每 IP 每分钟最多几次(默认 20)。
# 别调太小 —— 连点追问、页面自动探测都会算在里面。
# RATE_LIMIT_PER_MIN=20

# 全站每天最多几次(默认 2000)。这是防刷爆账单的兜底闸门。
# 按 deepseek-v4-flash 输出 ¥9/百万 tokens 粗估,2000 次约 ¥10 量级。
# RATE_LIMIT_PER_DAY=2000

# 需要额外放行哪些来源(逗号分隔)。默认只允许同源,
# 也就是"页面和 Functions 同一个域名"。
# 只有在你想让别的站点调用这套 API 时才需要配。
# ALLOWED_ORIGINS=https://example.com
