# ============================================
# 本地密钥 —— 复制本文件为 .dev.vars 后填写
# .dev.vars 已在 .gitignore 中,不会被提交到仓库
# ============================================

# 本项目只接 DeepSeek 一家 —— 境内直连、无需额外网络条件,
# 也是唯一端到端实测过的一条路(流式 / 视觉 / 扫描件)。
# 控制台 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ============================================
# 模型名覆盖 —— 官方改名时改这里,不用改代码
# 不填就用 functions/_lib/providers.js 里的默认值
# ============================================
#
# 官方支持的模型名**只有两个**(实测 GET /models):
#   deepseek-flash      快;而且是唯一支持识图的
#   deepseek-v4-pro     推理更强;不支持图片
# 别用 deepseek-v4-flash —— 它能跑通但不在支持列表里,属未公开别名。
#
# DEEPSEEK_MODEL_FAST=deepseek-flash      # 「快速」档
# DEEPSEEK_MODEL_DEEP=deepseek-v4-pro     # 「深度」档
# DEEPSEEK_VISION_MODEL=deepseek-flash    # 图片 / 扫描件解析专用

# ============================================
# 以下都是可选项,不填就用代码里的默认值
# ============================================

# 每 IP 每分钟最多几次(默认 20)。
# 别调太小 —— 连点追问、页面自动探测都会算在里面。
# RATE_LIMIT_PER_MIN=20

# 全站每天最多几次(默认 2000)。这是防刷爆账单的兜底闸门。
# 按 flash 的输出价粗估,2000 次约 ¥10 量级。
# RATE_LIMIT_PER_DAY=2000

# 需要额外放行哪些来源(逗号分隔)。默认只允许同源,
# 也就是"页面和 Functions 同一个域名"。
# 只有在你想让别的站点调用这套 API 时才需要配。
# ALLOWED_ORIGINS=https://example.com
